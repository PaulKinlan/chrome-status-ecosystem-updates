{
  "name": "chrome-status-ecosystem-updates",
  "version": "1.0.0",
  "description": "Weekly automated ecosystem intelligence reports for ChromeStatus features and Web APIs",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "chrome-status-ecosystem": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js run",
    "report": "node bin/cli.js run",
    "report:feature": "node bin/cli.js inspect",
    "serve": "node bin/cli.js serve",
    "test": "node --test --test-timeout=30000",
    "test:coverage": "node --test --test-timeout=30000 --experimental-test-coverage",
    "test:integration": "INTEGRATION=1 node --test --test-timeout=120000"
  },
  "keywords": [
    "chromestatus",
    "chromestatuslite",
    "web-platform",
    "web-api",
    "ecosystem",
    "weekly-report",
    "crawler",
    "developer-relations",
    "browser-compat"
  ],
  "author": "Paul Kinlan",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
