# =================================================================
# ChromeStatus Ecosystem Updates - Configuration
# =================================================================
# All configuration is optional! The system runs with rich built-in
# free sources (Hacker News Algolia, GitHub Standards Positions,
# NPM Registry, WPT Test Status, ChromeStatus API) out of the box.
# =================================================================

# Target Milestones: 'auto' (current beta), 'last-5' (last 5 releases), ranges ('150-154'), or comma-separated ('150,151,152,153,154')
TARGET_MILESTONES=auto

# Feature status filters (enabled, origin-trial, flagged, deprecated, removed)
FEATURE_STATUSES=enabled,origin-trial,flagged,deprecated

# Max features to process per run (leave blank or 0 for all features in milestone)
MAX_FEATURES=

# Search Provider: 'auto', 'gemini', 'brave', 'google', or 'ecosystem-only'
# In 'auto' mode, all search providers with configured API keys run concurrently.
# If GEMINI_API_KEY is set, Gemini's native Google Search Grounding runs live searches.
SEARCH_PROVIDER=auto

# 1. Google Gemini API (Recommended: Powers native Google Search Grounding & Synthesis)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# 2. Brave Search API (Recommended: Independent web index, https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# 3. Google Custom Search JSON API (Optional)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 4. GitHub Personal Access Token (Optional: raises GitHub API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# 5. Twitter / X Bearer Token (Optional: for recent developer discussions via Twitter API v2)
# In developer.x.com -> Your App -> Keys and Tokens -> "Bearer Token"
TWITTER_BEARER_TOKEN=

# 6. AI Summarization & Synthesis Provider: 'gemini' (default, with Google Search grounding), 'openai', or 'none'
AI_PROVIDER=gemini
OPENAI_API_KEY=

# Report output directory (default: ./reports)
REPORTS_DIR=./reports

# Local Preview Server Port (default: 3000)
PORT=3000
