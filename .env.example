# =================================================================
# ChromeStatus Ecosystem Updates - Configuration
# =================================================================
# All configuration is optional! The system runs with rich built-in
# free sources (Hacker News Algolia, GitHub Standards Positions,
# NPM Registry, WPT Test Status, ChromeStatus API) out of the box.
# =================================================================

# Target Milestones (comma-separated or 'auto' for current beta milestone)
TARGET_MILESTONES=auto

# Feature status filters (enabled, origin-trial, flagged, deprecated, removed)
FEATURE_STATUSES=enabled,origin-trial,flagged,deprecated

# Max features to process per run (leave blank or 0 for all features in milestone)
MAX_FEATURES=

# Search Provider: 'auto', 'tavily', 'google', 'brave', 'serper', or 'ecosystem-only'
SEARCH_PROVIDER=auto

# 1. Tavily AI Search (https://tavily.com - recommended for AI-powered web search)
TAVILY_API_KEY=

# 2. Google Custom Search JSON API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 3. Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# 4. Serper API (https://serper.dev)
SERPER_API_KEY=

# 5. GitHub Personal Access Token (optional, raises GitHub API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# 6. AI Summarization & Synthesis Provider: 'none', 'gemini', or 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Report output directory (default: ./reports)
REPORTS_DIR=./reports

# Local Preview Server Port (default: 3000)
PORT=3000
