# =================================================================
# ChromeStatus Ecosystem Updates - Configuration
# =================================================================
# All configuration is optional. The system runs with rich built-in
# free sources (Hacker News Algolia, GitHub Standards Positions,
# NPM Registry, WPT Test Status, ChromeStatus API) out of the box.
#
# Copy to `.env` and fill in whatever you have. Values already present
# in the real environment always win over this file.
# =================================================================

# Target Milestones: 'last-5' (default), 'auto'/'single'/'beta' (current beta only),
# an explicit milestone ('154'), a range ('150-154'), or a list ('150,151,152').
# Note: a bare number <= 20 is treated as "last N releases", not as milestone N.
TARGET_MILESTONES=last-5

# Feature status filters: enabled, origin-trial, flagged, deprecated, rollout
# (ChromeStatus's "Stepped rollout") and removed. The default is every status
# except `removed`; a feature listed under several milestones is reported once,
# at its most advanced status.
FEATURE_STATUSES=enabled,origin-trial,flagged,deprecated,rollout

# Max features to process per run (leave blank for all features in the milestones)
MAX_FEATURES=

# How many features to investigate in parallel (1-16, default 4).
# Each feature costs several LLM calls and 25-40 HTTP requests, so raising this
# speeds up a run but increases the chance of upstream rate limiting.
CONCURRENCY=4

# Stop starting new features after this many minutes (0 = no deadline, the default). Features already
# under way finish, and the report is published with what the crawl reached, marked as partial; the
# features it did not reach come first next time. The GitHub workflow sets 40, ten minutes before the
# step that runs the crawl is killed: a killed crawl publishes nothing.
CRAWL_DEADLINE_MINUTES=0

# Search Provider: 'auto' (default), 'gemini', 'brave', or 'google'.
# In 'auto' mode every provider with a configured key runs concurrently.
# If GEMINI_API_KEY is set, Gemini's native Google Search Grounding runs live searches.
# Naming a provider whose credentials are missing disables web search entirely.
SEARCH_PROVIDER=auto

# 1. Google Gemini API (Recommended: powers Google Search Grounding & synthesis)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Tried first. If it is overloaded, too slow or retired, the crawler falls back to
# gemini-3.5-flash and then gemini-flash-lite-latest (see "Safety Checks & Run Health").
GEMINI_MODEL=gemini-3.8-flash

# 2. Brave Search API (Recommended: independent web index, https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# 3. Google Custom Search JSON API (Optional; needs BOTH values to work)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 4. GitHub Personal Access Token (Optional: raises GitHub API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# 5. Twitter / X Bearer Token (Optional: recent developer discussions via Twitter API v2)
# developer.x.com -> Your App -> Keys and Tokens -> "Bearer Token"
# TWITTER_BEARER_TOKEN and X_BEARER_TOKEN are the same setting: set either one. A blank one is
# ignored, and TWITTER_BEARER_TOKEN is used if both are set.
TWITTER_BEARER_TOKEN=

# 6. AI synthesis.
# NOTE: this value is advisory. The analyzer tries Gemini if GEMINI_API_KEY is set,
# then OpenAI if OPENAI_API_KEY is set (also when Gemini could not answer), else a
# local heuristic engine. To force the heuristic engine, simply leave both keys blank.
AI_PROVIDER=gemini
OPENAI_API_KEY=

# Report output directory (default: ./reports)
REPORTS_DIR=./reports

# Where the week-over-week history snapshots live (default: ./data).
# Point this somewhere disposable for trial runs so they cannot touch the
# real history.
DATA_DIR=./data

# Safety checks refuse to publish when ChromeStatus returns suspiciously few
# features or most features fail to analyse (so a bad run cannot overwrite a good
# report). Set to 1/true to publish anyway; same as `run --force`.
FORCE_REPORT=

# Local preview server. HOST defaults to loopback; set 0.0.0.0 only if you
# intend to expose the (unauthenticated) report server on your network.
PORT=3000
HOST=127.0.0.1

# ChromeStatus endpoints (the defaults are shown). Change them only to point at a
# mirror or a test server.
CHROMESTATUS_API_URL=https://chromestatus.com
CHROMESTATUSLITE_URL=https://chromestatuslite.com

# Set to any value to print the full error, with its stack, when a command fails.
DEBUG=
