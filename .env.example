# =================================================================
# ChromeStatus Ecosystem Updates - Configuration
# =================================================================
# All configuration is optional! The system runs with rich built-in
# free sources (Hacker News Algolia, GitHub Standards Positions,
# NPM Registry, WPT Test Status, ChromeStatus API) out of the box.
# =================================================================

# Target Milestones (comma-separated or 'auto' for current beta milestone)
TARGET_MILESTONES=auto

# Feature status filters (enabled, origin-trial, flagged, deprecated, removed)
FEATURE_STATUSES=enabled,origin-trial,flagged,deprecated

# Max features to process per run (leave blank or 0 for all features in milestone)
MAX_FEATURES=

# Search Provider: 'auto', 'gemini', 'tavily', 'google', 'brave', 'serper', or 'ecosystem-only'
# If GEMINI_API_KEY is provided and SEARCH_PROVIDER is 'auto' or 'gemini', Gemini's native
# Google Search Grounding is used to execute live web searches and fetch grounded sources.
SEARCH_PROVIDER=auto

# 1. Google Gemini API (Recommended: Powers native Google Search Grounding & Synthesis)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Tavily AI Search (https://tavily.com - alternative web search)
TAVILY_API_KEY=

# 3. Google Custom Search JSON API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 4. Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# 5. Serper API (https://serper.dev)
SERPER_API_KEY=

# 6. GitHub Personal Access Token (optional, raises GitHub API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# 7. AI Summarization & Synthesis Provider: 'gemini' (default, with Google Search grounding), 'openai', or 'none'
AI_PROVIDER=gemini
OPENAI_API_KEY=

# Report output directory (default: ./reports)
REPORTS_DIR=./reports

# Local Preview Server Port (default: 3000)
PORT=3000
